# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Test / coverage — ANCHORED ON PURPOSE. A bare `coverage/` matches a directory
# of that name at ANY depth, which silently untracked the 15 real source files in
# `packages/gates/src/coverage/` (the coverage-ratchet store and its four
# ecosystem adapters, re-exported from `packages/gates/src/index.ts`). The repo
# built locally and only locally: a clean checkout was missing the directory
# entirely and `tsc -b` failed with 12 TS2307s, so CI was red on every leg and
# no ARM64 evidence could ever be produced. Anchor every new entry the same way.
/coverage/
/packages/*/coverage/
/e2e/*/coverage/
/e2e/matrix/*/coverage/
.vitest-cache/

# Logs
npm-debug.log*
*.log

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Env
.env
.env.*
!.env.example

# Changesets pre-release state (not applicable until phase 23 cuts a release)
.changeset/pre.json

# Phase 06 @live run artifact (regenerated each `npm run test:live`; uploaded by the engine-live CI job)
packages/engine-claude/live-run-record.json

# Phase 23 work item 1 @live run artifact (regenerated each release-gate-report
# generator run; archived by the release-e2e CI job)
e2e/release-gate-report.json

{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "mcp__crabgic_gateway__*"
    ],
    "deny": [
      "Agent",
      "WebFetch",
      "WebSearch",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(~/.local/state/crabgic/**)",
      "Read(~/.cache/crabgic/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.local/state/crabgic/**)",
      "Edit(~/.cache/crabgic/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Write(~/.local/state/crabgic/**)",
      "Write(~/.cache/crabgic/**)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Edit(//<worktree>/.git/**)",
      "Write(//<worktree>/.git/**)"
    ],
    "ask": []
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [],
      "allowAllUnixSockets": true,
      "allowLocalBinding": false
    },
    "filesystem": {
      "allowWrite": [
        "<worktree>",
        "<worker-tmp>"
      ],
      "denyWrite": [
        "<worktree>/.git",
        "<worktree>/.git/**",
        "~/.local/state/crabgic/**",
        "~/.cache/crabgic/**",
        "~/.ssh/**",
        "~/.aws/**"
      ],
      "denyRead": [
        "~/.local/state/crabgic/**",
        "~/.cache/crabgic/**",
        "~/.ssh/**",
        "~/.aws/**"
      ]
    },
    "credentials": {
      "envVars": []
    }
  }
}

{
  "name": "@crabgic/git-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Git engine: control repo, worktrees, overlap analysis (phase 07); merge preflight, CAS refs, neutral Git rendering, local publication (phase 08).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-support/**"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@crabgic/contracts": "0.0.0",
    "@crabgic/journal": "0.0.0",
    "@crabgic/renderer": "0.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@crabgic/testkit": "0.0.0",
    "fast-check": "4.9.0"
  }
}

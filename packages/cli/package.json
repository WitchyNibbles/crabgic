{
  "name": "crabgic",
  "version": "1.7.0",
  "description": "crabgic CLI & doctor (roadmap/09-cli-and-doctor.md).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WitchyNibbles/crabgic.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/WitchyNibbles/crabgic#readme",
  "bugs": {
    "url": "https://github.com/WitchyNibbles/crabgic/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "crabgic": "dist/bin.js",
    "crabgic-supervisord": "dist/bin/supervisord.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-support/**",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@crabgic/renderer": "0.0.0",
    "@crabgic/testkit": "0.0.0",
    "fast-check": "4.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2"
  }
}

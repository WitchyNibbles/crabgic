{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "externalConnectionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "canonicalTarget": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "requiredCapabilityFlags": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "assignment",
          "reporter change",
          "closing transitions",
          "sprint completion",
          "attachments",
          "bulk mutations",
          "issue creation",
          "alert disabling",
          "contact points",
          "mute timings",
          "notification templates"
        ]
      }
    },
    "redactedDiff": {
      "type": "string",
      "minLength": 1
    },
    "desiredStateHash": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "expectedRemoteRevision": {
      "type": "string",
      "minLength": 1
    },
    "impactClass": {
      "type": "string",
      "minLength": 1
    },
    "rollbackClass": {
      "type": "string",
      "minLength": 1
    },
    "envelopeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "externalConnectionId",
    "tenant",
    "canonicalTarget",
    "action",
    "redactedDiff",
    "desiredStateHash",
    "idempotencyKey",
    "impactClass",
    "rollbackClass",
    "envelopeId"
  ],
  "additionalProperties": false
}

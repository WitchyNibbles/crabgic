{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "deploymentType": {
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "allowedRedirectOrigins": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "tenantAllowlist": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "orgAllowlist": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projectAllowlist": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "folderAllowlist": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "customCaRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "allowedResources": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedActions": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discoveryTtlSeconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "secretRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "const": "env"
            },
            "variable": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "backend",
            "variable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "backend",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "const": "exec"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "backend",
            "command"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "provider",
    "baseUrl",
    "allowedRedirectOrigins",
    "allowedResources",
    "allowedActions",
    "discoveryTtlSeconds",
    "secretRef"
  ],
  "additionalProperties": false
}

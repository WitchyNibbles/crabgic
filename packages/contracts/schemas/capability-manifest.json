              },
              "digest": {
                "type": "string",
                "minLength": 1
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved",
                  "rejected"

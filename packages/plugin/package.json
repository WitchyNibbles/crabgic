{
  "name": "@crabgic/plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code plugin: skills, subagents, advisory hooks, status line, gateway MCP registration reference (roadmap/10-plugin-and-installer.md).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-support/**",
    ".claude-plugin",
    ".mcp.json",
    "skills",
    "agents",
    "hooks",
    "statusline"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@crabgic/contracts": "0.0.0",
    "@crabgic/engine-claude": "0.0.0",
    "zod": "4.4.3"
  }
}

{
  "name": "crabgic-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Crabgic monorepo root (private workspaces root; the published CLI package is packages/cli, name \"crabgic\").",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle:types && npm run bundle:cli",
    "build:clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:live": "vitest run --bail=1 --config vitest.live.config.ts",
    "test:e2e": "node scripts/run-e2e-suites.mjs --file-parallelism",
    "test:e2e:release-evidence": "node scripts/run-e2e-suites.mjs",
    "check:e2e-types": "node scripts/check-e2e-types.mjs",
    "lint": "eslint . --ignore-pattern 'spikes/**'",
    "lint:fix": "eslint . --fix --ignore-pattern 'spikes/**'",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "probe:support-windows": "tsx e2e/provisioning/src/supportWindowsCli.ts",
    "probe:perf-contract-rerun": "tsx e2e/attestation/src/perfContractRerunCli.ts",
    "check:workspace-count": "node scripts/check-workspace-count.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:marketplace-pin": "node scripts/check-marketplace-pin-digest.mjs",
    "check:engine-pin": "node scripts/check-engine-pin.mjs",
    "check:criteria-closeout": "node scripts/check-criteria-closeout.mjs",
    "check:criteria-baseline": "node scripts/generate-criteria-baseline.mjs --check",
    "check:citation-runs": "node scripts/check-citation-runs.mjs",
    "check:citation-content": "node scripts/check-citation-content.mjs",
    "check:all": "npm run check:workspace-count && npm run check:package-graph && npm run check:hygiene && npm run check:release-notes && npm run check:marketplace-pin && npm run check:engine-pin && npm run check:criteria-closeout && npm run check:criteria-baseline && npm run check:citation-runs && npm run check:citation-content && npm run check:tarball && npm run check:install-smoke",
    "check:package-graph": "node scripts/check-package-graph-acyclic.mjs",
    "check:tarball": "node scripts/check-published-tarball.mjs",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "check:install-smoke": "node scripts/check-install-smoke.mjs",
    "bundle:types": "node scripts/bundle-types.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "js-yaml": "4.3.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
